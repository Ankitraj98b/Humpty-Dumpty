# backend/.env
# Copy this file to backend/.env and fill in your values

# MongoDB Connection String
# Local:  mongodb://localhost:27017/humptydumpty
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/humptydumpty
MONGO_URI=mongodb://localhost:27017/humptydumpty

# Server Port
PORT=5000

# (Optional) Razorpay Keys — for real payment gateway
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# (Optional) JWT Secret — for admin login
# JWT_SECRET=your_super_secret_key_here
